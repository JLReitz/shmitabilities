{
  "name": "@jlreitz/shmit-core",
  "version": "0.1.0",
  "description": "Shared managed-root and settings reader for Shmitabilities packages.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
