{
  "name": "@jlreitz/shmitty-system",
  "version": "0.1.0",
  "description": "Shmitty workflow skills and knowledge and task commands for Codex, Pi, and DSH.",
  "keywords": [
    "pi-package",
    "dsh",
    "skills"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/dsh/index.js",
  "types": "./dist/dsh/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/dsh/index.d.ts",
      "default": "./dist/dsh/index.js"
    },
    "./core": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin/knowledge-cli",
    "bin/task-cli",
    "bin/knowledge_cli/*.py",
    "bin/task_cli/*.py",
    "bin/shmitty_core/*.py",
    "bin/requirements.txt",
    "bin/requirements-ontology.txt",
    "pyproject.toml",
    "skills/",
    "src/",
    "dist/",
    "hooks/",
    "cordis.patch.yml",
    ".codex-plugin/plugin.json",
    ".mcp.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit --project tsconfig.test.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-working-directory": "0.2.1-alpha.3",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-working-directory": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-working-directory": "0.2.1-alpha.3",
    "@dprint/typescript": "^0.96.1",
    "@earendil-works/pi-coding-agent": "^0.80.6",
    "@types/node": "^22.0.0",
    "dprint": "^0.64.3",
    "typescript": "^5.0.0",
    "vitest": "^5.0.5"
  },
  "pi": {
    "extensions": [
      "./src/pi-shmitty-system/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "bin": {
    "knowledge-cli": "./bin/knowledge-cli",
    "task-cli": "./bin/task-cli"
  }
}
